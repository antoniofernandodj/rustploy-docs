---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="shot">
  <a href={src.src} target="_blank" rel="noopener" title="Abrir em tamanho cheio">
    <Image src={src} alt={alt} widths={[740, 1100, 1600]} sizes="(min-width: 72rem) 50rem, 100vw" loading="lazy" />
  </a>
  {caption && <figcaption>{caption} <span class="shot__hint">Clique para ampliar.</span></figcaption>}
</figure>

<style>
  .shot {
    margin: 1.5rem 0;
  }
  .shot a {
    display: block;
    line-height: 0;
  }
  .shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .shot figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-body-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }
  .shot__hint {
    opacity: 0.8;
  }
</style>
